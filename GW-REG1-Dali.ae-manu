    "Procedure": "<LoadProcedures>\r\n  <LoadProcedure MergeId=\"1\">\r\n    <LdCtrlCompareProp InlineData=\"00FA\" ObjIdx=\"0\" PropId=\"12\">\r\n      <OnError Cause=\"CompareMismatch\" MessageRef=\"loadErrorManu\" />\r\n    </LdCtrlCompareProp>\r\n    <LdCtrlCompareProp InlineData=\"0000A4010800\" ObjIdx=\"0\" PropId=\"78\">\r\n      <OnError Cause=\"CompareMismatch\" MessageRef=\"loadErrorApp\" />\r\n    </LdCtrlCompareProp>\r\n  </LoadProcedure>\r\n  <LoadProcedure MergeId=\"2\">\r\n    <LdCtrlRelSegment LsmIdx=\"4\" Size=\"2200\" Mode=\"1\" Fill=\"0\" AppliesTo=\"full\" />\r\n    <LdCtrlRelSegment LsmIdx=\"4\" Size=\"2200\" Mode=\"0\" Fill=\"0\" AppliesTo=\"par\" />\r\n  </LoadProcedure>\r\n  <LoadProcedure MergeId=\"4\">\r\n    <LdCtrlWriteRelMem ObjIdx=\"4\" Offset=\"0\" Size=\"2200\" Verify=\"true\" AppliesTo=\"full,par\" />\r\n  </LoadProcedure>\r\n  <LoadProcedure MergeId=\"7\">\r\n    <LdCtrlLoadImageProp ObjIdx=\"1\" PropId=\"27\" />\r\n    <LdCtrlLoadImageProp ObjIdx=\"2\" PropId=\"27\" />\r\n    <LdCtrlLoadImageProp ObjIdx=\"3\" PropId=\"27\" />\r\n    <LdCtrlLoadImageProp ObjIdx=\"4\" PropId=\"27\" />\r\n  </LoadProcedure>\r\n</LoadProcedures>",
