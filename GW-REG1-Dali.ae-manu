      {
        "$type": "Kaenx.Creator.Models.Helptext, Kaenx.Creator.Share",
        "UId": 21,
        "Name": "NET-Allgemein",
        "Text": [
          {
            "$type": "Kaenx.Creator.Models.Translation, Kaenx.Creator.Share",
            "Language": {
              "$type": "Kaenx.Creator.Models.Language, Kaenx.Creator.Share",
              "CultureCode": "de-DE",
              "Text": "Deutsch"
            },
            "Text": "### Allgemein\n\nIn diesem Abschnitt werden die Basiseinstellungen und verfügbaren Dienste festgelegt.\n\n",
            "Preview": "### Allgemein\n\nIn diesem Abschnitt werden die Basiseinstellungen und verfügbaren Dienste festgelegt...."
