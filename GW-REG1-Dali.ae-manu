                  {
                    "$type": "Kaenx.Creator.Models.Dynamic.DynChooseBlock, Kaenx.Creator.Share",
                    "IsExpanded": false,
                    "Name": "",
                    "IsGlobal": true,
                    "ParameterRef": 71,
                    "Items": [
                      {
                        "$type": "Kaenx.Creator.Models.Dynamic.DynWhenBlock, Kaenx.Creator.Share",
                        "IsExpanded": false,
                        "Name": "",
                        "IsDefault": false,
                        "Condition": "1",
                        "Items": [
                          {
                            "$type": "Kaenx.Creator.Models.Dynamic.DynButton, Kaenx.Creator.Share",
                            "IsExpanded": false,
                            "Online": "ConnectionOriented",
                            "EventHandlerParameters": "{ Channel: {{argChan}} }",
                            "Cell": null,
                            "Access": 2,
                            "Id": -1,
                            "Name": "read",
                            "Script": "// Start read devicetype\r\nprogress.setText(device.getMessage(2));\r\n\r\nvar data = [2, context.Channel];\r\nonline.connect();\r\nvar resp = online.invokeFunctionProperty(160, 1, data); //invoke readdevicetype\r\n\r\nif (resp[0] != 0) {\r\n    // Dali Error:\r\n    throw new Error(device.getMessage(1) + String(resp[0]));\r\n}\r\n\r\nvar para = device.getParameterByName(\"deviceType\");\r\nif(resp[1] == 255)\r\n{\r\n    para.value = 0;\r\n    throw new Error(device.getMessage(14)) // Unknown DeviceType\r\n}\r\n\r\npara.value = (resp[1]+1).toString();\r\n\r\nif(resp[1] == 6 || resp[1] == 8)\r\n{\r\n    var byte = resp[2];\r\n    \r\n    para = device.getParameterByName(\"colorSpace\");\r\n    para.value = (byte & 1) ? \"1\" : \"0\";\r\n    \r\n\r\n    para = device.getParameterByName(\"colorType\");\r\n    para.value = (byte & 2) ? \"2\" : \"1\";\r\n}\r\n\r\n// Read Successfully devicetype\r\nprogress.setText(device.getMessage(3));",
                            "UseTextParameter": false,
                            "TextRef": -1,
                            "UseIcon": false,
                            "IconId": -1,
                            "Text": [
                              {
                                "$type": "Kaenx.Creator.Models.Translation, Kaenx.Creator.Share",
                                "Language": {
                                  "$type": "Kaenx.Creator.Models.Language, Kaenx.Creator.Share",
                                  "CultureCode": "de-DE",
                                  "Text": "Deutsch"
                                },
                                "Text": "Auslesen",
                                "Preview": "Auslesen"
                              }
                            ],
                            "TranslationText": false,
                            "Items": []
                          }
                        ]
                      }
