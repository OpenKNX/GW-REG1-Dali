      {
        "$type": "Kaenx.Creator.Models.Helptext, Kaenx.Creator.Share",
        "UId": 14,
        "Name": "EVG_scene",
        "Text": [
          {
            "$type": "Kaenx.Creator.Models.Translation, Kaenx.Creator.Share",
            "Language": {
              "$type": "Kaenx.Creator.Models.Language, Kaenx.Creator.Share",
              "CultureCode": "de-DE",
              "Text": "Deutsch"
            },
            "Text": "## Szenenobjekt\r\nEmpfangene Szenennummern werden im Bereich von 1-16 direkt an das einzelne EVG gesendet.  \r\nDabei gilt es zu beachten, dass die KNX Szenennummer -1 der Dali Szenennummer entspricht.  \r\nBeispiele:\r\n * Empfangene Szene 1 -> Sende Szene 0\r\n * Empfangene Szene 16 -> Sende Szene 15\r\n * Empgangene Szene 20 -> keine Szene wird gesendet",
            "Preview": "## Szenenobjekt Empfangene Szenennummern werden im Bereich von 1-16 direkt an das einzelne EVG gese..."
          }
        ],
        "TranslationText": false
      },
      {
        "$type": "Kaenx.Creator.Models.Helptext, Kaenx.Creator.Share",
        "UId": 15,
        "Name": "GRP_scene",
        "Text": [
          {
            "$type": "Kaenx.Creator.Models.Translation, Kaenx.Creator.Share",
            "Language": {
              "$type": "Kaenx.Creator.Models.Language, Kaenx.Creator.Share",
              "CultureCode": "de-DE",
              "Text": "Deutsch"
            },
            "Text": "## Szenenobjekt\r\nEmpfangene Szenennummern werden im Bereich von 1-16 direkt an die Gruppe gesendet.  \r\nDabei gilt es zu beachten, dass die KNX Szenennummer - 1 der Dali Szenennummer entspricht.  \r\nBeispiele:\r\n * Empfangene Szene 1 -> Sende Szene 0\r\n * Empfangene Szene 16 -> Sende Szene 15\r\n * Empgangene Szene 20 -> keine Szene wird gesendet",
            "Preview": "## Szenenobjekt Empfangene Szenennummern werden im Bereich von 1-16 direkt an die Gruppe gesendet. ..."
          }
        ],
        "TranslationText": false
      },
